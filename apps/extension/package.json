{
  "name": "extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "build:chrome": "cross-env BROWSER=chrome tsc -b && cross-env BROWSER=chrome vite build",
    "build:chrome:dev": "cross-env BROWSER=chrome tsc -b && cross-env BROWSER=chrome vite build --mode development",
    "build:firefox": "cross-env BROWSER=firefox tsc -b && cross-env BROWSER=firefox vite build",
    "build:firefox:dev": "cross-env BROWSER=firefox tsc -b && cross-env BROWSER=firefox vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-router": "^1.140.0",
    "@workspace/audio-processing": "workspace:*",
    "@workspace/azkar": "workspace:*",
    "@workspace/lib": "workspace:*",
    "@workspace/model": "workspace:*",
    "@workspace/ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "vite-plugin-static-copy": "^3.1.4",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tanstack/router-plugin": "^1.163.2",
    "@types/chrome": "^0.1.37",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "link:tanstack/router-plugin/vite"
  }
}
