{
  "manifest_version": 3,
  "name": "Katheera - Hands-Free Zikr Counter",
  "version": "1.0",
  "description": "A hands-free digital sebha that automatically counts your zikr. Remember Allah while you browse.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/default16.png",
      "32": "icons/default32.png",
      "48": "icons/default48.png",
      "128": "icons/default128.png"
    }
  },
  "background": {
    "scripts": ["background.firefox.js"],
    "type": "module"
  },
  "icons": {
    "16": "icons/default16.png",
    "32": "icons/default32.png",
    "48": "icons/default48.png",
    "128": "icons/default128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*", "model/*", "sandbox.html", "assets/*", "listening.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "katheera@zikr-ai",
      "strict_min_version": "128.0"
    }
  }
}