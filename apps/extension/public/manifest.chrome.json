{
  "manifest_version": 3,
  "name": "Katheera - Hands-Free Zikr Counter",
  "version": "1.1.1",
  "version_name": "0.1.0-beta.2",
  "description": "A hands-free digital sebha that automatically counts your zikr. Remember Allah while you browse.",
  "permissions": ["storage", "offscreen"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/default16.png",
      "32": "icons/default32.png",
      "48": "icons/default48.png",
      "128": "icons/default128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/default16.png",
    "32": "icons/default32.png",
    "48": "icons/default48.png",
    "128": "icons/default128.png"
  },
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"
  }
}
