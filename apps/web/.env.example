# Copy to .env and fill in real values. Never commit .env.
# Edge Impulse ingestion key stays server-only (used by /api/contribute/push-to-ei).
# There is intentionally no NEXT_PUBLIC_* Edge Impulse key: uploads go through the
# server proxy so the key is never baked into client bundles. DevAudioDebugger
# only renders in development and receives the server key as a prop.

EDGE_IMPULSE_API_KEY=ei_your_ingestion_api_key
EDGE_IMPULSE_PROJECT_ID=your_project_id

SUPABASE_PROJECT_ID=your_project_id
SUPABASE_SECRET=sb_secret_your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_PUBLIC_API=sb_publishable_your_key

# Strong random value. Required by /api/contribute/* admin routes.
ADMIN_SECRET=change-this-to-a-strong-secret-before-deploying
