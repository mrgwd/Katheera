{
  "name": "web",
  "version": "0.1.0-beta.2",
  "type": "module",
  "private": true,
  "scripts": {
    "copy-model": "mkdir -p public/model && rm -rf public/model/* && cp -R ../../packages/model/src/model/* public/model/",
    "dev": "next dev --turbopack",
    "build": "pnpm copy-model && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@workspace/audio-processing": "workspace:*",
    "@workspace/azkar": "workspace:*",
    "@workspace/lib": "workspace:*",
    "@workspace/model": "workspace:*",
    "@workspace/styles": "workspace:*",
    "@workspace/ui": "workspace:*",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
